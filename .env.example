APP_ENV=local
APP_NAME=Housing Finance Core
APP_VERSION=0.1.0
API_PREFIX=/api/v1
# --- 상품 데이터베이스 ---
# 상품 DB는 원격 서버에 있어 **SSH 터널을 거쳐야** 닿는다. 앱은 터널을 열지
# 않는다 — 애플리케이션이 SSH 비밀번호를 들고 있으면 배포 때 걷어내야 할 부채가
# 되고, 재연결·수명 관리가 앱 책임이 된다. 그래서 서버를 띄우기 전에 터널을
# 먼저 올리고, 앱은 아래 주소(로컬 포트)만 본다.
#
#   ssh -N -L 5432:localhost:5432 -p <SSH_PORT> <사용자>@<SSH_HOST>
#
# 호스트는 127.0.0.1, 포트는 위에서 바인딩한 로컬 포트다.
DATABASE_URL=postgresql+psycopg://<사용자>:<비밀번호>@127.0.0.1:5432/<DB명>
PROPERTY_LISTING_JSON_PATH=sample_data/property_listings/property_listings.v1.json
CORS_ORIGINS=http://localhost:3000

# --- 보고서 설명 AI (선택) ---
# 비우면 AI 설명을 생략하고 고정 템플릿 보고서만 제공한다. 기능이 꺼질 뿐
# 계산 결과는 그대로 나온다.
#
# 키는 https://aistudio.google.com/apikey 에서 발급한다.
# 이 파일(.env.example)에는 절대 실제 키를 넣지 말 것 — 커밋되는 파일이다.
# 실제 키는 .gitignore가 막아 주는 .env 에만 넣는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# 외부 AI로 나가기 직전 계좌번호·주민번호·연락처 형태의 값을 찾아 전송을
# 차단한다. Gemini API 무료 등급은 제출한 프롬프트를 검토·학습에 사용할 수
# 있다고 Google 약관에 명시돼 있어 기본값을 true로 둔다.
# 끄면 그 검사 없이 전송된다 — 실제 사용자 데이터로는 끄지 말 것.
REPORT_AI_EGRESS_GUARD=true
